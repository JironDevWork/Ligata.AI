@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{ Layout = null; }
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@Model.Name</title>
<style>body{font-family:Georgia,serif;margin:0;background:#faf8f4;color:#222}.site{display:flex;gap:18px;max-width:760px;margin:auto;padding:14px 24px}main{max-width:760px;margin:auto;padding:40px 24px}h1{font-size:44px}.far{margin-top:1400px}footer{max-width:760px;margin:auto;padding:24px;border-top:1px solid #ddd}</style></head>
<body>
  <header class="site"><nav><a href="/">Home</a> · <a href="/prices/">Prices</a> · <a href="/contact/">Contact</a></nav></header>
  <main><header><h1>@Model.Name</h1></header>@Html.Raw(Model.Value<string>("bodyText"))
    @* Layout parts the knowledge index does not read: showing the way finds them on the page itself. *@
    <details><summary>Workshop access</summary><p>The workshop door code is FOLDED-OAK-8.</p></details>
    <section class="far"><h2>Directions</h2><p>Park behind the building and use entrance FAR-AWAY-5.</p></section>
  </main>
  <footer><p>Ligata Test Studio · Studio line +41 44 000 00 00 · Dielsdorf</p></footer>
</body>
</html>
